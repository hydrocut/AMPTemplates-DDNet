Meta.DisplayName=DDNet (TeamKit)
Meta.Description=Serveur dedie DDraceNetwork. Parkour cooperatif, classements par carte, 64 places. C'est la ou sont les joueurs : sur les 4 859 joueurs Teeworlds en ligne, 4 850 sont sur la famille 0.6/DDNet et 9 sur du 0.7 vanilla. Les reglages sont ecrits dans myServerconfig.cfg, l'emplacement officiel qu'une mise a jour de DDNet n'ecrase jamais.
Meta.OS=Linux
Meta.Arch=x86_64
Meta.AarchSupport=NotSupported
Meta.Author=TeamKit, d'apres le template Teeworlds de CubeCoders
Meta.URL=https://github.com/hydrocut/AMPTemplates-DDNet
Meta.DisplayImageSource=steam:412220
Meta.EndpointURIFormat=
Meta.ConfigManifest=ddnetconfig.json
Meta.MetaConfigManifest=ddnetmetaconfig.json
Meta.ConfigRoot=ddnet.kvp
Meta.MinAMPVersion=2.6.0.0
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Supported
Meta.ContainerPolicyReason=
Meta.ExtraSetupStepsURI=https://ddnet.org/settingscommands/
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=["libcurl4","xz-utils"]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1
Meta.ReleaseNotes=
Meta.BreakingReleaseNotes=
Meta.AppConfigId=aeeb424a-6e67-4a5e-be6f-318a7e0a2b1d
Meta.ImportableExtensions=[]
Meta.AppIsMultiIPAware=False
